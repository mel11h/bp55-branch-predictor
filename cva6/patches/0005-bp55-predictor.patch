+`else  // BP55_PRED
+  // ---------------------------------------------------------------------------
+  // BP55 (rtl/bp55.sv, copied unmodified by cva6/cva6.sh) in place of BHT/BTB/RAS,
+  // looked up at CVA6's own prediction point (option A of cva6/README.md):
+  // f_pc = the address of the pre-decoded instruction in icache_data_q, and the
+  // lookup is accepted (f_fire) when the instruction enters the instruction queue.
+  // Pre-decode decides what is a control-flow instruction:
+  //   conditional branch : direction f_dir (TAGE, valid on a BTB miss too),
+  //                        target from the immediate
+  //   JAL                : always taken, target from the immediate
+  //   return             : f_ras_top
+  //   other JALR         : f_target (ITC, else BTB) when the BTB hit as an indirect
+  //                        jump, otherwise no prediction (resolved in EX)
+  // BP55's own speculative update depends on its BTB hit and type. When that
+  // disagrees with what the predicted path needs (BTB miss on a call, return, or
+  // a branch predicted taken; type mismatch; a hit on a non-control-flow word),
+  // the frontend redirects fetch to the predicted next PC (one killed fetch, as
+  // for a predicted-taken instruction) and repairs BP55 in the next cycle
+  // (r_fire with the instruction's checkpoint and the predicted operation), when
+  // no lookup can be accepted. EX mispredicts repair with the actual operation,
+  // controller flushes restore the checkpoint of the instruction at commit.
+  // Requires RVC = 0 (one instruction per fetch).
+  // ---------------------------------------------------------------------------
+  localparam logic [2:0] T_COND = 3'd0, T_JUMP = 3'd1, T_CALL = 3'd2, T_RET = 3'd3,
+                         T_IND = 3'd4, T_ICALL = 3'd5, T_NONE = 3'd7;
+  if (CVA6Cfg.RVC || CVA6Cfg.INSTR_PER_FETCH != 1) begin : gen_bp55_cfg_check
+    $fatal(1, "BP55_PRED requires RVC = 0");
+  end
+
+  logic         bp55_f_busy, bp55_f_hit, bp55_f_taken, bp55_f_dir;
+  logic [2:0]   bp55_f_type, bp55_type;
+  logic [31:0]  bp55_f_target, bp55_f_ras_top;
+  logic [103:0] bp55_f_meta;
+  logic [66:0]  bp55_f_ckpt;
+  logic         bp55_raw_fire, bp55_f_fire, bp55_need, bp55_fe_redirect;
+  logic         bp55_sp_cond, bp55_sp_push, bp55_sp_pop, bp55_sp_ind, bp55_known;
+  logic         bp55_o_shift, bp55_o_push, bp55_o_pop, bp55_o_thr;
+  logic [CVA6Cfg.INSTR_PER_FETCH-1:0][173:0] bp55_rec;
+
+  // control-flow class of the pre-decoded word, as iss/rvsim and BP55's model classify it
+  // (rd = link first, then rs1 = link; link = x1 or x5)
+  logic bp55_rd_link, bp55_rs1_link;
+  assign bp55_rd_link  = (instr[0][11:7] == 5'd1) || (instr[0][11:7] == 5'd5);
+  assign bp55_rs1_link = (instr[0][19:15] == 5'd1) || (instr[0][19:15] == 5'd5);
+  always_comb begin
+    unique case (instr[0][6:0])
+      riscv::OpcodeBranch: bp55_type = T_COND;
+      riscv::OpcodeJal:    bp55_type = bp55_rd_link ? T_CALL : T_JUMP;
+      riscv::OpcodeJalr:   bp55_type = bp55_rd_link ? T_ICALL : bp55_rs1_link ? T_RET : T_IND;
+      default:             bp55_type = T_NONE;
+    endcase
+  end
+
+  always_comb begin
+    taken_rvi_cf = '0;
+    taken_rvc_cf = '0;
+    predict_address = '0;
+    cf_type[0] = ariane_pkg::NoCF;
+    cf_valid = '0;
+    ras_push = 1'b0;
+    ras_pop = 1'b0;
+    ras_update = '0;
+    if (instruction_valid[0]) begin
+      unique case (bp55_type)
+        T_COND: if (bp55_f_dir) begin
+          taken_rvi_cf[0] = 1'b1;
+          cf_type[0] = ariane_pkg::Branch;
+          cf_valid[0] = 1'b1;
+          predict_address = addr[0] + rvi_imm[0];
+        end
+        T_JUMP, T_CALL: begin
+          taken_rvi_cf[0] = 1'b1;
+          cf_type[0] = ariane_pkg::Jump;
+          cf_valid[0] = 1'b1;
+          predict_address = addr[0] + rvi_imm[0];
+        end
+        T_RET: begin
+          cf_type[0] = ariane_pkg::Return;
+          cf_valid[0] = ~bp55_f_busy;
+          predict_address = bp55_f_ras_top[CVA6Cfg.VLEN-1:0];
+        end
+        T_IND, T_ICALL: begin
+          cf_type[0] = ariane_pkg::JumpR;
+          if (bp55_f_hit && (bp55_f_type == T_IND || bp55_f_type == T_ICALL)) begin
+            cf_valid[0] = 1'b1;
+            predict_address = bp55_f_target[CVA6Cfg.VLEN-1:0];
+          end
+        end
+        default:
+        // mret/sret/uret: CVA6's own handling (pre-decoded as a jump to its own address)
+        if (rvi_jump[0]) begin
+          taken_rvi_cf[0] = 1'b1;
+          cf_type[0] = ariane_pkg::Jump;
+          cf_valid[0] = 1'b1;
+          predict_address = addr[0] + rvi_imm[0];
+        end
+      endcase
+    end
+  end
+
+  // speculative operation BP55 applied for this lookup (BTB view) and the one the
+  // predicted path needs (pre-decode view)
+  assign bp55_sp_cond = bp55_f_hit && bp55_f_type == T_COND;
+  assign bp55_sp_push = bp55_f_hit && (bp55_f_type == T_CALL || bp55_f_type == T_ICALL);
+  assign bp55_sp_pop  = bp55_f_hit && bp55_f_type == T_RET;
+  assign bp55_sp_ind  = bp55_f_hit && (bp55_f_type == T_IND || bp55_f_type == T_ICALL);
+  assign bp55_o_shift = bp55_type == T_COND && (bp55_sp_cond || bp55_f_dir);
+  assign bp55_o_push  = bp55_type == T_CALL || bp55_type == T_ICALL;
+  assign bp55_o_pop   = bp55_type == T_RET;
+  assign bp55_o_thr   = bp55_type == T_IND || bp55_type == T_ICALL;
+  // an indirect jump without a BTB prediction mispredicts in EX, which repairs everything
+  assign bp55_known   = !bp55_o_thr || bp55_sp_ind;
+
+  // lookup accepted: the instruction enters the instruction queue and is not flushed
+  assign bp55_raw_fire = instruction_valid[0] & instr_queue_consumed[0] & ~flush_i;
+  assign bp55_need = bp55_raw_fire & ~bp55_f_busy & bp55_known &
+                     ((bp55_sp_cond != bp55_o_shift) | (bp55_sp_push != bp55_o_push) |
+                      (bp55_sp_pop != bp55_o_pop) | (bp55_sp_ind != bp55_o_thr));
+  assign bp55_fe_redirect = bp55_need;
+
+  assign bp55_rec[0] = {bp55_type, bp55_f_ckpt, bp55_f_meta};
+
+  // ---- redirect / repair and training (one pulse each) ----
+  logic         bp55_fe_q, bp55_ph_q, bp55_ph_pend;
+  logic [66:0]  bp55_fe_ckpt_q;
+  logic         bp55_fe_shift_q, bp55_fe_taken_q, bp55_fe_push_q, bp55_fe_pop_q, bp55_fe_thr_q;
+  logic [31:0]  bp55_fe_push_addr_q, bp55_fe_target_q, bp55_ph_pc_q;
+  logic [103:0] bp55_ph_meta_q;
+  logic         bp55_ctrl, bp55_exr, bp55_r_fire, bp55_ex_u, bp55_u_fire, bp55_u_ph;
+  logic [66:0]  bp55_r_ckpt;
+  logic         bp55_r_ghr_shift, bp55_r_taken, bp55_r_push, bp55_r_pop, bp55_r_thr;
+  logic [31:0]  bp55_r_push_addr, bp55_r_target;
+  logic [2:0]   bp55_ex_type;
+  logic         bp55_ex_bhit;
+  logic [2:0]   bp55_ex_btype;
+  logic         bp55_ph_drop;
+
+  assign bp55_ex_type  = bp55_ex_i[173:171];
+  assign bp55_ex_bhit  = bp55_ex_i[0];
+  assign bp55_ex_btype = bp55_ex_i[3:1];
+
+  always_ff @(posedge clk_i or negedge rst_ni) begin
+    if (!rst_ni) begin
+      bp55_fe_q <= 1'b0;
+      bp55_fe_ckpt_q <= '0;
+      {bp55_fe_shift_q, bp55_fe_taken_q, bp55_fe_push_q, bp55_fe_pop_q, bp55_fe_thr_q} <= '0;
+      bp55_fe_push_addr_q <= '0;
+      bp55_fe_target_q <= '0;
+      bp55_ph_pend <= 1'b0;
+      bp55_ph_pc_q <= '0;
+      bp55_ph_meta_q <= '0;
+    end else begin
+      bp55_fe_q <= bp55_need;
+      if (bp55_need) begin
+        bp55_fe_ckpt_q <= bp55_f_ckpt;
+        bp55_fe_shift_q <= bp55_o_shift;
+        bp55_fe_taken_q <= bp55_sp_cond ? bp55_f_dir : 1'b1;  // = the predicted direction
+        bp55_fe_push_q <= bp55_o_push;
+        bp55_fe_pop_q <= bp55_o_pop;
+        bp55_fe_thr_q <= bp55_o_thr;
+        bp55_fe_push_addr_q <= 32'(addr[0]) + 32'd4;
+        bp55_fe_target_q <= bp55_f_target;
+      end
+      // a BTB hit on a non-control-flow word (phantom) is trained with u_isbr = 0 in
+      // the first cycle in which EX sends no training message
+      if (bp55_raw_fire && !bp55_f_busy && bp55_f_hit && bp55_type == T_NONE) begin
+        bp55_ph_pend <= 1'b1;
+        bp55_ph_pc_q <= 32'(addr[0]);
+        bp55_ph_meta_q <= bp55_f_meta;
+      end else if (bp55_u_ph) bp55_ph_pend <= 1'b0;
+    end
+  end
+  assign bp55_ph_drop = bp55_ph_pend && !bp55_u_ph && bp55_raw_fire && !bp55_f_busy &&
+                        bp55_f_hit && bp55_type == T_NONE;  // (testbench counter)
+
+  // redirect priority: controller flush (older, at commit) > EX mispredict > frontend repair
+  assign bp55_ctrl = ex_valid_i | eret_i | set_pc_commit_i | (CVA6Cfg.DebugEn & set_debug_pc_i);
+  assign bp55_exr  = is_mispredict;
+  assign bp55_r_fire = bp55_ctrl | bp55_exr | bp55_fe_q;
+  always_comb begin
+    bp55_r_ckpt = bp55_fe_ckpt_q;
+    {bp55_r_ghr_shift, bp55_r_taken, bp55_r_push, bp55_r_pop, bp55_r_thr} =
+        {bp55_fe_shift_q, bp55_fe_taken_q, bp55_fe_push_q, bp55_fe_pop_q, bp55_fe_thr_q};
+    bp55_r_push_addr = bp55_fe_push_addr_q;
+    bp55_r_target = bp55_fe_target_q;
+    if (bp55_ctrl) begin
+      // plain checkpoint restore: refetch from (or after) the instruction at commit
+      bp55_r_ckpt = bp55_commit_i[170:104];
+      {bp55_r_ghr_shift, bp55_r_taken, bp55_r_push, bp55_r_pop, bp55_r_thr} = '0;
+    end else if (bp55_exr) begin
+      // EX mispredict: checkpoint of the branch plus its actual operation
+      bp55_r_ckpt = bp55_ex_i[170:104];
+      bp55_r_ghr_shift = bp55_ex_type == T_COND &&
+                         ((bp55_ex_bhit && bp55_ex_btype == T_COND) || resolved_branch_i.is_taken);
+      bp55_r_taken = resolved_branch_i.is_taken;
+      bp55_r_push = bp55_ex_type == T_CALL || bp55_ex_type == T_ICALL;
+      bp55_r_pop = bp55_ex_type == T_RET;
+      bp55_r_thr = bp55_ex_type == T_IND || bp55_ex_type == T_ICALL;
+      bp55_r_push_addr = 32'(resolved_branch_i.pc) + 32'd4;
+      bp55_r_target = 32'(resolved_branch_i.target_address);
