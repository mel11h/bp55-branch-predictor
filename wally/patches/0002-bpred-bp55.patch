+    assign BTAWrongE    = PCSrcE & MTakenE & (BranchE | JumpE & TypeE != T_RET) & (PCD != IEUAdrE);
+    assign RASWrongE    = JumpE & TypeE == T_RET & PCSrcE & ({MRasTopE, 2'b00} != IEUAdrE[31:0]);
+    assign IClassWrongE = (MBhitE != IsCFE) | (MBhitE & IsCFE & MBtypeE != TypeE);
+    flopenrc #(5) BP55HPMReg(clk, reset, FlushM, ~StallM,
+      {BPDirWrongE, BTAWrongE, RASWrongE, IClassWrongE & InstrValidE, RepairOnlyE},
+      {BPDirWrongM, BTAWrongM, RASPredPCWrongM, IClassWrongBPM, BP55RepairOnlyM});
+    assign IClassWrongM = IClassWrongBPM;
+    assign BPRedirectD = 1'b0;
+    assign {BTBCallF, BTBReturnF, BTBJumpF, BTBBranchF} = '0;
 
