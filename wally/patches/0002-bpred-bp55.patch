+    // synopsys translate_on
+
+    bp55 BP55(.clk, .rst_n(~reset),
+      .f_pc(PCF[31:0]), .f_fire(FFire), .f_busy(FBusy), .f_hit(FHit), .f_type(FType), .f_taken(FTaken),
+      .f_target(FTarget), .f_dir(FDir), .f_ras_top(FRasTop), .f_meta(FMeta), .f_ckpt(FCkpt),
