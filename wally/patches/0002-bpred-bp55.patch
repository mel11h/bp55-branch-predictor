+    flopenrc #(67)  CkptEReg(clk, reset, FlushE, ~StallE, CkptD, CkptE);
+    flopenrc #(3)   TypeEReg(clk, reset, FlushE, ~StallE, TypeD, TypeE);
+    flopenrc #(67)  CkptMReg(clk, reset, FlushM, ~StallM, CkptE, CkptM);
+
+    // fields of the lookup metadata (layout of f_meta in bp55.sv)
+    assign MBhitE   = MetaE[0];
+    assign MBtypeE  = MetaE[3:1];
+    assign MIndE    = MetaE[33:4];
+    assign MDirE    = MetaE[103];
+    assign MRasTopE = CkptE[66:37];
+    assign MTakenE  = MBhitE & (MBtypeE != T_COND | MDirE);    // = f_taken of the lookup
+    assign IsCFE    = BranchE | JumpE;
+
+    // E-stage check: the survey / sim/cosim.cc rule for the speculative update
+    assign SpCond = MBhitE & MBtypeE == T_COND;
+    assign SpPush = MBhitE & (MBtypeE == T_CALL | MBtypeE == T_ICALL);
+    assign SpPop  = MBhitE & MBtypeE == T_RET;
+    assign SpInd  = MBhitE & (MBtypeE == T_IND | MBtypeE == T_ICALL);
+    assign AShift = BranchE & (SpCond | PCSrcE);
+    assign APush  = JumpE & (TypeE == T_CALL | TypeE == T_ICALL);
+    assign APop   = JumpE & TypeE == T_RET;
+    assign AThr   = JumpE & (TypeE == T_IND | TypeE == T_ICALL);
+    assign NeedE  = (SpCond != AShift) | (AShift & MDirE != PCSrcE) | (SpPush != APush) | (SpPop != APop) |
+                    (SpInd != AThr) | (AThr & {MIndE, 2'b00} != IEUAdrE[31:0]);
+    mux2 #(P.XLEN) pccorrectemux(PCLinkE, IEUAdrE, PCSrcE, PCCorrectE);
+    assign PCWrongE = PCCorrectE != PCD;
+    assign BPWrongE = (PCWrongE | NeedE) & InstrValidE & InstrValidD;
+    assign RepairOnlyE = NeedE & ~PCWrongE & InstrValidE & InstrValidD;
+
+    // redirect / repair: one pulse per redirect. The E redirect fires when its instruction leaves E;
+    // a trap, trap return or CSR write / fence in M kills E, D and F and restores the checkpoint of the
