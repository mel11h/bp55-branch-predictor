+  end else if (P.BPRED_TYPE == BP_BP55) begin : bp55bp
+    ////////////////////////////////////////////////////////////////////////////////////////////////
+    // BP55 (rtl/bp55.sv of bp55-branch-predictor, copied to src/ifu/bpred/bp55.sv by its harness).
+    // Lookup in F, combinational from PCF; an instruction is accepted (f_fire) when it moves from
+    // F to D. Everything is verified in E against the full PC (PCCorrectE vs PCD), as with Wally's
+    // own predictors, plus a repair redirect when BP55's speculative history/stack update for the
+    // instruction was wrong although the fetched next PC was right. Training in E.
+    ////////////////////////////////////////////////////////////////////////////////////////////////
+    localparam logic [2:0] T_COND = 3'd0, T_JUMP = 3'd1, T_CALL = 3'd2, T_RET = 3'd3, T_IND = 3'd4, T_ICALL = 3'd5;
+    logic          FFire, FTaken, RFire, RFireE, RFireFlush, UFire;
+    logic [31:0]   FTarget;
+    logic [103:0]  FMeta, MetaD, MetaE;
+    logic [66:0]   FCkpt, CkptD, CkptE, CkptM, RCkpt;
+    logic [2:0]    TypeD, TypeE;
+    logic          IsLinkRdD, IsLinkRs1D, IsJalrD;
+    logic          MBhitE, MDirE, MTakenE;
+    logic [2:0]    MBtypeE;
+    logic [29:0]   MIndE, MRasTopE;
+    logic          SpCond, SpPush, SpPop, SpInd, AShift, APush, APop, AThr, NeedE, PCWrongE;
+    logic          IsCFE;
+    logic [P.XLEN-1:0] PC0NextF, PCCorrectE;
+    logic          BPDirWrongE, BTAWrongE, RASWrongE, IClassWrongE, RepairOnlyE;
+    logic          IClassWrongBPM;
+    logic          FBusy, FHit, FDir;
+    logic [2:0]    FType;
+    logic [31:0]   FRasTop;
+
+    // fetch-accept: the instruction in F enters D at this edge. FlushD covers every redirect
+    // (BPWrongE, TrapM, RetM, CSRWriteFenceM), so f_fire is never 1 in an r_fire cycle.
+    assign FFire = ~StallD & ~FlushD & ~reset;
+
+    // actual control-flow type, decoded in D like iss/rvsim does (rd link first, then rs1 link)
+    assign IsLinkRdD  = (InstrD[11:7]  & 5'h1B) == 5'h01;
