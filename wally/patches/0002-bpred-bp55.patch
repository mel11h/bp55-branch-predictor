+      .r_thr_shift(~RFireFlush & AThr), .r_target(IEUAdrE[31:0]),
+      .u_fire(UFire), .u_isbr(IsCFE), .u_pc(PCE[31:0]), .u_type(TypeE), .u_taken(PCSrcE),
+      .u_target(IEUAdrE[31:0]), .u_meta(MetaE));
+
+    mux2 #(P.XLEN) pcmux0(PCPlus2or4F, P.XLEN'(FTarget), FTaken, PC0NextF);
+    mux2 #(P.XLEN) pcmux1(PC0NextF, PCCorrectE, BPWrongE, PC1NextF);
